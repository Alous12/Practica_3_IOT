{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerElHistorico",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:us-east-2:<ACCOUNT_ID>:table/vigilante_historico"
    },
    {
      "Sid": "ActuarSoloPorDesired",
      "Effect": "Allow",
      "Action": "iot:UpdateThingShadow",
      "Resource": "arn:aws:iot:us-east-2:<ACCOUNT_ID>:thing/vigilante-*"
    }
  ]
}
