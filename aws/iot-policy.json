{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConectarSoloConSuNombreDeThing",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:us-east-2:<ACCOUNT_ID>:client/${iot:Connection.Thing.ThingName}"
    },
    {
      "Sid": "PublicarSoloEnSuShadow",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:iot:us-east-2:<ACCOUNT_ID>:topic/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
    },
    {
      "Sid": "SuscribirseSoloASuShadow",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": "arn:aws:iot:us-east-2:<ACCOUNT_ID>:topicfilter/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
    },
    {
      "Sid": "RecibirSoloDeSuShadow",
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": "arn:aws:iot:us-east-2:<ACCOUNT_ID>:topic/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
    }
  ]
}
